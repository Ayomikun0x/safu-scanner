# --- Robinhood Chain ---
RPC_URL=https://rpc.mainnet.chain.robinhood.com
FACTORY_ADDRESS=0x1f7d7550b1b028f7571e69a784071f0205fd2efa
EXPLORER_API=https://robinhoodchain.blockscout.com/api/v2

# How often to scan for new pools, in minutes
SCAN_INTERVAL_MINUTES=5

# Minimum liquidity (in ETH, roughly) before a pool is even worth showing you.
# Pools below this are almost always too thin to trade safely.
MIN_LIQUIDITY_ETH=0.5

# --- Dashboard access ---
# This password is what YOU type to log into the website. Make it your own.
DASHBOARD_PASSWORD=change-me-please
SESSION_SECRET=change-this-to-a-random-string

# Railway sets PORT automatically, this is just a local fallback
PORT=3000
